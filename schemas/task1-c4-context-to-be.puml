@startuml task1-c4-context-to-be
!include <C4/C4_Context>

title Диаграмма контекста (C4, уровень 1) - целевая экосистема «Кинобездна»

Person(viewer, "Пользователь", "Смотрит фильмы с ноутбука, мобильного устройства или смарт ТВ, ставит оценки, собирает папки с избранным.")

System(cinemaabyss, "Кинобездна", "Онлайн-кинотеатр-агрегатор: единая подписка на контент сторонних сервисов и открытых источников.")

System_Ext(payment, "Платёжные системы", "Списание оплаты по подписке, возвраты, токенизация карт.")
System_Ext(loyalty, "Сервисы лояльности", "Бонусы, промокоды, партнёрские скидки.")
System_Ext(marketplace, "Маркетплейсы", "Продажа подписок через партнёрские каналы.")
System_Ext(cinemas, "Онлайн-кинотеатры и открытые источники", "Внешние каталоги и видеопотоки, которые агрегирует «Кинобездна».")
System_Ext(recommender, "Рекомендательная система", "Сторонний сервис, формирует персональные подборки.")
System_Ext(storage, "Объектное хранилище S3", "Постеры, трейлеры, субтитры, сегменты видео.")
System_Ext(cdn, "CDN", "Раздача видео и статики на устройства пользователей.")

Rel(viewer, cinemaabyss, "Аутентификация, каталог, просмотр, оценки, управление подпиской", "HTTPS")
Rel(cdn, viewer, "Отдаёт видеопоток и статику", "HTTPS, HLS")

Rel(cinemaabyss, payment, "Инициирует платежи, принимает колбэки", "HTTPS, REST")
Rel(cinemaabyss, loyalty, "Применяет бонусы и промокоды", "HTTPS, REST")
Rel(cinemaabyss, marketplace, "Синхронизирует подписки партнёрских продаж", "HTTPS, REST")

Rel(cinemaabyss, cinemas, "Забирает каталоги и ссылки на видеопотоки", "HTTPS, REST")
Rel(cinemaabyss, storage, "Читает и пишет медиафайлы", "S3 API")
Rel(cinemaabyss, cdn, "Публикует контент, инвалидирует кеш", "HTTPS")

Rel(cinemaabyss, recommender, "Передаёт события просмотров и оценок", "Kafka")
Rel(recommender, cinemaabyss, "Возвращает персональные подборки", "HTTPS, REST")

SHOW_LEGEND()
@enduml
